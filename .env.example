# העתיקו קובץ זה ל-.env ומלאו את הערכים.

# חובה — הטוקן שמקבלים מ-@BotFather בטלגרם (/newbot)
BOT_TOKEN=123456:ABC-your-token-here

# מזהה הגיליון (מתוך כתובת ה-URL). ברירת המחדל היא הגיליון הקיים.
SHEET_ID=1ybPhMiIba43GawAzHNl9AJiMCBi61t4NWhQuXCYVwag

# אופציונלי — gid של לשונית ספציפית בגיליון (אם יש כמה לשוניות)
SHEET_GID=

# מועדי שליחה קבועים לערוץ (שעון ישראל), מופרדים בפסיק.
# מעבר לזה — כל שינוי בגיליון נשלח מיד ממילא.
POST_TIMES=07:30,15:30,23:30

# אזור זמן ומשך מטמון (שניות)
TZ=Asia/Jerusalem
CACHE_TTL_SECONDS=60

# אופציונלי — אם api.telegram.org חסום ברשת שלך, הזיני כתובת פרוקסי
# למשל: socks5://127.0.0.1:1080  או  http://user:pass@host:port
PROXY_URL=
